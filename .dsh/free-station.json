{
  "version": 1,
  "note": "免费全家桶可选安装注册表（数据文件）。全部官方源；安装前逐个审批；每个条目自带 verify，装没装以命令输出为准，失败即停。新工具 = 加一条目 + 发一个 patch，机制不变。语音与笔记是零安装集成，见 zero_install。",
  "tools": [
    {
      "id": "yt-dlp",
      "name": "yt-dlp 视频下载",
      "why": "官方 winget / brew 包",
      "install": {
        "windows": ["winget", "install", "--id", "yt-dlp.yt-dlp", "-e", "--silent", "--accept-source-agreements", "--accept-package-agreements"],
        "macos": ["brew", "install", "yt-dlp"],
        "linux": ["sudo", "apt-get", "install", "-y", "yt-dlp"]
      },
      "verify": {
        "windows": ["yt-dlp", "--version"],
        "macos": ["yt-dlp", "--version"],
        "linux": ["yt-dlp", "--version"]
      }
    },
    {
      "id": "ffmpeg",
      "name": "FFmpeg 视频处理",
      "why": "官方 winget 包 Gyan.FFmpeg",
      "install": {
        "windows": ["winget", "install", "--id", "Gyan.FFmpeg", "-e", "--silent", "--accept-source-agreements", "--accept-package-agreements"],
        "macos": ["brew", "install", "ffmpeg"],
        "linux": ["sudo", "apt-get", "install", "-y", "ffmpeg"]
      },
      "verify": {
        "windows": ["ffmpeg", "-version"],
        "macos": ["ffmpeg", "-version"],
        "linux": ["ffmpeg", "-version"]
      }
    },
    {
      "id": "obsidian",
      "name": "Obsidian 笔记",
      "why": "装好后直接打开记忆文件夹就是金库，零集成",
      "install": {
        "windows": ["winget", "install", "--id", "Obsidian.Obsidian", "-e", "--silent", "--accept-source-agreements", "--accept-package-agreements"],
        "macos": ["brew", "install", "--cask", "obsidian"]
      },
      "verify": {
        "windows": ["winget", "list", "--id", "Obsidian.Obsidian", "-e", "--accept-source-agreements"],
        "macos": ["which", "obsidian"]
      },
      "manual": "https://obsidian.md/download"
    }
  ],
  "zero_install": [
    {
      "id": "voice",
      "name": "语音：DSH 自带语音输入（实验性插件 voice-input-bundle，本地 SenseVoice）+ 系统自带语音朗读",
      "how": "零安装；在 DSH 插件管理页启用实验性语音输入（随包默认禁用），首次用会下载 SenseVoiceSmall 模型文件，官方自带 hf-mirror.com 国内源；朗读是让 agent 调系统语音（Windows SAPI、macOS say）生成音频，DSH 本身没有朗读"
    },
    {
      "id": "notebooklm",
      "name": "NotebookLM 学习助手（海外：需谷歌账号，国内网络打不开）",
      "how": "零安装；对 agent 说「把交接单导出成学习笔记」，它整理好你贴进 NotebookLM；没有谷歌账号就跳过这条"
    }
  ]
}

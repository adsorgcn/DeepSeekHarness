    "/api/skills": {
      "get": {
        "operationId": "dsh_list_skills",
        "summary": "Read published market records for skills, books and plugins.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Read published market records for skills, books and plugins.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "format": "uri"
                    },
                    "marketUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "entries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "Published record from market/registry.json, including kind, name, version, description and provenance.",
                        "additionalProperties": true
                      }
                    },
                    "plugins": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "Official plugin-index record.",
                        "additionalProperties": true
                      }
                    }
                  },
                  "required": [
                    "source",
                    "marketUrl",
                    "entries",
                    "plugins"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, unavailable source, or unsupported path.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Invalid arguments, unavailable source, or unsupported path.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/healthz": {
      "get": {
        "operationId": "dsh_health",
        "summary": "Check service liveness.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Check service liveness.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, unavailable source, or unsupported path.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Invalid arguments, unavailable source, or unsupported path.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "externalDocs": {
    "description": "MCP and HTTP API usage",
